FROM rust:1.90 AS build

RUN rustup target add x86_64-unknown-linux-musl

WORKDIR /src
COPY . .

RUN cargo build \
    --release \
    --target x86_64-unknown-linux-musl

FROM scratch

COPY --from=build \
    /src/target/x86_64-unknown-linux-musl/release/server \
    /server

WORKDIR /site

COPY functions/ /site/functions/
COPY dev/ /site/dev/

ENV RES_ROOT=/site

EXPOSE 80

CMD ["/server"]
